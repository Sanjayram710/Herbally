# Environment Configuration
ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./marketing.db

# Replaceable LLM Provider Configuration
# Leave blank to use the built-in deterministic/mock LLM provider (0 cost, zero API keys required)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Research Provider Configuration
# Leave blank to use the built-in verified sample/mock research provider
SEARCH_PROVIDER=mock
SEARCH_API_KEY=

# Image generation and durable local media storage
# Leave IMAGE_PROVIDER as unconfigured unless you intentionally enable billable OpenAI image generation.
IMAGE_PROVIDER=unconfigured
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_REQUEST_TIMEOUT_SECONDS=90
MEDIA_MAX_BYTES=20971520
MEDIA_STORAGE_DIR=media
MAX_IMAGE_DIMENSION=4096
MAX_IMAGE_PIXELS=16777216

# Local-only authentication. Do not deploy this token; use AUTH_MODE=token with
# server-side AUTH_TOKENS_JSON provisioned by your identity/access management process.
AUTH_MODE=development
AUTH_DEV_TOKEN=herbally-local-dev-token
AUTH_DEV_USER_ID=local-user
AUTH_DEV_WORKSPACE_ID=local-workspace
LEGACY_WORKSPACE_ID=local-workspace
AUTH_TOKENS_JSON=
REQUEST_MAX_BYTES=5242880
IMAGE_GENERATION_REQUEST_MAX_BYTES=16384
IMAGE_GENERATION_RATE_LIMIT=5
IMAGE_GENERATION_RATE_WINDOW_SECONDS=3600

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
