# Copy this file to backend/.env before starting the FastAPI server.
ENV=development
DEBUG=True
PORT=8001
HOST=127.0.0.1

DATABASE_URL=sqlite:///./marketing_v2.db

# Existing text and search adapters remain in local mock mode unless configured.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
SEARCH_PROVIDER=mock
SEARCH_API_KEY=

# Leave this unconfigured until a server-side OpenAI key is intentionally supplied.
IMAGE_PROVIDER=unconfigured
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_REQUEST_TIMEOUT_SECONDS=90
IMAGE_MAX_PROMPT_CHARS=4000
MEDIA_MAX_BYTES=20971520
MEDIA_STORAGE_DIR=media
MAX_IMAGE_DIMENSION=4096
MAX_IMAGE_PIXELS=16777216

# Local-only authentication. Never use this shared development token in a deployed environment.
AUTH_MODE=development
AUTH_DEV_TOKEN=herbally-local-dev-token
AUTH_DEV_USER_ID=local-user
AUTH_DEV_WORKSPACE_ID=local-workspace
LEGACY_WORKSPACE_ID=local-workspace
# For production use AUTH_MODE=token and configure a JSON object mapping bearer tokens
# to {"subject":"user-id","workspace_id":"workspace-id","display_name":"Name","role":"member"}.
AUTH_TOKENS_JSON=

REQUEST_MAX_BYTES=5242880
IMAGE_GENERATION_REQUEST_MAX_BYTES=16384
IMAGE_GENERATION_RATE_LIMIT=5
IMAGE_GENERATION_RATE_WINDOW_SECONDS=3600

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
